bot "Planner"
database sqlite "planner.db"
timezone "Europe/Kyiv"

setting remind_at: time = 18:00
setting remind_days: days = 3, 1
setting digest_at: time = 09:00
setting greeting: text = "Привіт"
store tasks:
    title, due

roles:
    owner 5218929723

# дата завжди у форматі РРРР-ММ-ДД, наприклад 2026-11-01
command "task" with due title:
    only for member
    add tasks with title = title, due = due
    reply "Збережено: {title} (до {due})"

command "tasks":
    only for member
    find tasks where title contains ""
    show found

command "done" with id:
    only for member
    delete tasks where id is id
    reply "Готово. Напиши /undo, щоб повернути."

# щодня о 18:00: за 3 дні і за 1 день до дати
remind tasks by due before setting.remind_days days at setting.remind_at:
    notify me "⏰ {setting.greeting}! {title}: залишилось днів {days} (до {due})"

every day at setting.digest_at:
    find tasks where title contains ""
    notify me found